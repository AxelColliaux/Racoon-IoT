{
  "name": "smartposture-gateway",
  "version": "1.0.0",
  "description": "Passerelle SmartPosture : Serial/TCP/Mock → Backend (HTTP ou MQTT)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "mock": "node src/index.js --mode=mock",
    "serial": "node src/index.js --mode=serial",
    "tcp": "node src/index.js --mode=tcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "dotenv": "^16.3.1",
    "mqtt": "^5.3.0",
    "serialport": "^12.0.0"
  }
}
