# Obligatoire : URL de connexion MongoDB (ex. mongodb://localhost:27017 ou MongoDB Atlas)
MONGODB_URI=

# Optionnel : nom de la base (défaut : smartposture)
# MONGODB_DB_NAME=smartposture

PORT=3000

# Optionnel : MQTT pour ingestion télémetrie
# MQTT_BROKER=mqtt://localhost:1883
# MQTT_TOPIC=smartposture/telemetry
